Diagnostics:
  UnusedIncludes: None

Index:
  Background: Build

---
If:
  PathMatch: (.*\/)?DLSlime/.*\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$
CompileFlags:
  CompilationDatabase: DLSlime/build

---
If:
  PathMatch: (.*\/)?dlengine/.*\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$
CompileFlags:
  CompilationDatabase: dlengine/build
  Add:
    - -Idlengine
    - -INanoCommon/include
    - -Idlengine/build/dlengine/csrc/sequence

---
CompileFlags:
  Add:
    - -std=c++20
