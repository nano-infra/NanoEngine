namespace dlslime.fbs;

struct IbvGid {
  raw: [ubyte: 16];
}

table RdmaInfo {
  qpn: uint32;
  gid: IbvGid;
  gidx: int64;
  lid: uint16;
  psn: uint64;
  mtu: uint64;
}

table RemoteMr {
  addr: uint64;
  length: uint64;
  rkey: uint32;
  mr_key: uint64;
}

table RdmaEndpointInfo {
  mr_info: [RemoteMr];
  io_info: [RdmaInfo];
  msg_meta_info: [RdmaInfo];
  msg_data_info: [RdmaInfo];
  remote_meta_base: RemoteMr;
}

root_type RdmaEndpointInfo;
