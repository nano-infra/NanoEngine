{
  "uid": "dlengine-overview",
  "title": "DLEngine Overview",
  "tags": ["dlengine"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "dlengine_requests", "legendFormat": "{{state}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "tps"}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "dlengine_throughput_tokens_per_second", "legendFormat": "{{phase}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "dlengine_tokens", "legendFormat": "{{type}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "KV Blocks",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "dlengine_kv_blocks", "legendFormat": "{{state}} dp={{dp}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Step Latency",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "dlengine_step_latency_ms", "legendFormat": "{{phase}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Forward Transfer",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "dlengine_forward_bytes", "legendFormat": "{{direction}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Transfer Latency",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "dlengine_transfer_latency_ms", "legendFormat": "{{phase}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prefix Cache Hit Rate",
      "gridPos": {"x": 0, "y": 24, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "dlengine_prefix_cache_hit_rate_per_dp", "legendFormat": "dp={{dp}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "dlengine_prefix_cache_hit_rate", "legendFormat": "overall", "refId": "B"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "TTFT",
      "gridPos": {"x": 8, "y": 24, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.5, rate(dlengine_ttft_seconds_bucket[5m]))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.9, rate(dlengine_ttft_seconds_bucket[5m]))", "legendFormat": "p90", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.99, rate(dlengine_ttft_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "rate(dlengine_ttft_seconds_sum[5m]) / clamp_min(rate(dlengine_ttft_seconds_count[5m]), 1e-9)", "legendFormat": "avg", "refId": "D"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "TPOT",
      "gridPos": {"x": 16, "y": 24, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.5, rate(dlengine_tpot_seconds_bucket[5m]))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.9, rate(dlengine_tpot_seconds_bucket[5m]))", "legendFormat": "p90", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.99, rate(dlengine_tpot_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "rate(dlengine_tpot_seconds_sum[5m]) / clamp_min(rate(dlengine_tpot_seconds_count[5m]), 1e-9)", "legendFormat": "avg", "refId": "D"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    }
  ]
}
