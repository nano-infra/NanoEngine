namespace nanodeploy.fbs;

enum SequenceStatus : byte {
  WAITING = 0,
  RUNNING = 1,
  FINISHED = 2,
  TO_BE_MIGRATED = 3,
  PREFILLING = 4,
}

struct BlockLocation {
  first: int;
  second: int;
}

table IntList {
  values: [int];
}

// Per-ratio block-table entry for DSv4 compressed KV cache.
// Each sequence owns a list of pages (block_ids) in the pool for each
// compression ratio (e.g. 4, 128).
table CompressedBlockTable {
  ratio: int;
  block_ids: [int];
}

table BlockContext {
  engine_id: string;
  dp_idx: int;
  master_group_id: int;
  group_size: int;
  attention_dp: int;
  num_kvcache_blocks: int;
  state_slot: int = -1;
  block_location: [BlockLocation];
  num_dispatched_tokens: [int];
  group_block_table: [IntList];
  endpoints: [string];
  compressed_block_tables: [CompressedBlockTable];
}

table SamplingParams {
  temperature: double = 1.0;
  max_tokens: int = 256;
  ignore_eos: bool;
  // When true, the sampler computes log_softmax of the chosen token at each
  // decode step and the worker ships them through StepOut.logprobs to be
  // accumulated in Sequence.completion_logprobs. Used by NanoRL to build
  // honest off-policy importance ratios on the trainer (ratios = exp(
  // current_logprobs - old_logprobs) where old comes from this field).
  // Append-only field — defaults to false on legacy buffers.
  return_completion_logprobs: bool = false;
}

// Vision embedding slot reference on the encoder side.
// Each slot occupies a contiguous region in the encoder's EmbeddingPool buffer.
table VisionSlot {
  encoder_engine_id: string;  // Encoder engine that owns this slot
  slot_idx: int = -1;         // Slot index in the encoder's EmbeddingPool
  num_tokens: int;            // Number of merged vision tokens in this slot
  hidden_size: int;           // Hidden dimension of each token embedding
  max_tokens_per_slot: int;   // Encoder pool slot stride (max tokens per slot)
}

table Sequence {
  seq_id: uint64;
  status: SequenceStatus;
  sampling_params: SamplingParams;
  last_token: int;
  num_tokens: int;
  num_prompt_tokens: int;
  num_checkpointed_tokens: int;
  num_cached_tokens: int;
  token_ids: [int];
  slots: [BlockContext];  // Direct vector - size enforced in C++ code
  vision_slots: [VisionSlot];  // Vision embedding references (EP separated mode)
  // Per-completion-token logprobs (length == num_completed_tokens, parallel
  // to the completion slice of token_ids). Populated only when sampling_params
  // .return_completion_logprobs is true; otherwise empty/absent. Append-only
  // field — legacy buffers deserialise to an empty vector.
  completion_logprobs: [float];
}

table SequenceList {
  sequences: [Sequence];
}

table StepOut {
  seq_id: uint64;
  token_id: uint;  // Deprecated: kept for backward compatibility
  token_ids: [uint];  // New field: supports multiple tokens
  status: SequenceStatus;
  // Per-token logprobs of the chosen tokens, parallel to token_ids. Populated
  // only when the sampler is asked to return them (SamplingParams.
  // return_completion_logprobs=true). Append-only field — legacy buffers
  // deserialise to an empty vector and the scheduler skips the append.
  logprobs: [float];
}

table FreeSequences {
  seq_ids: [uint64];
  source_engine_id: string;
}

// P2P message from Prefill to Encoder to release vision embedding slots.
table FreeVisionSlots {
  encoder_engine_id: string;   // Target encoder engine
  slot_indices: [int];         // Slot indices to free
  source_engine_id: string;    // Prefill engine that consumed the embeddings
}

root_type SequenceList;
