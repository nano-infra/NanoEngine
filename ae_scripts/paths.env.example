# Machine-specific paths for the AE scripts.
#
# Copy this file to paths.env and fill in the paths for your host:
#
#     cp paths.env.example paths.env
#
# paths.env is gitignored, so your machine paths stay out of the repository.
#
# Every path below must resolve identically on all nodes of a multi-node run.


# Model weights: set only those used by the selected experiments.
# Use checkpoint directories directly, including Hugging Face snapshot paths.
AE_DPSK_MODEL=/path/to/DeepSeek-V3
AE_KIMI_MODEL=/path/to/Kimi-K2-Instruct-0905

# Datasets.
AE_DATASET_ROOT=/path/to/dataset
AE_DATASET_SHAREGPT4O=/path/to/dataset/sharegpt-4o
AE_DATASET_MIXLONG_0326=/path/to/dataset/sharegpt-4o-mixlong-0326
AE_DATASET_MADHA=/path/to/dataset/madha/Gemini_Issues_Stats_rename-shuffle.csv

# Optional runner workloads; leave unset unless selecting Qwen or 1k1k.
# AE_QWEN3_MODEL=/path/to/models/qwen3-235B-fp8
# AE_QWEN3_MODEL_1024K=/path/to/models/qwen3-235B-fp8-1024k
# AE_DATASET_0110=/path/to/dataset-0110/1024-1024.csv

# External checkouts.
AE_VLLM_ROOT=/path/to/vllm

# Recorded Fig. 20 baseline runs used as the NanoDeploy reference series.
AE_FIG20_NANO_RUN_DIR=/path/to/NanoDeploy/bench_logs/<run-name>
